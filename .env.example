# Byline Environment Configuration (Meta-authored AI models only)

# 1. Meta Model API
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# 2. OpenRouter (Meta-authored models)
OPENROUTER_API_KEY=
FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. Baseten (Meta-hosted models)
BASETEN_API_KEY=
BASETEN_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Local / Self-hosted Meta models (vLLM / Ollama)
LOCAL_BASE_URL=
LOCAL_MODEL=meta-llama/llama-3.1-8b-instruct

# LanguageTool (Optional spellchecking)
LANGUAGETOOL_URL=http://localhost:8010/v2/check

# Supabase (Optional waitlist storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173
