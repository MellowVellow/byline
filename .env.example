# Byline Environment Configuration (Meta-authored AI models only)

# 1. Baseten (Primary Meta-model provider — Hackathon)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# 2. Meta Model API (Fallback)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# 3. OpenRouter (Tertiary fallback — Meta allowlist only)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 4. Local vLLM (Optional; opt-in first-choice only with LOCAL_PREFER=1)
LOCAL_BASE_URL=
LOCAL_MODEL=meta-llama/llama-3.1-8b-instruct
LOCAL_PREFER=

# Supabase (waitlist storage). Apply supabase/waitlist.sql first.
# Use the service role key: the backend proxies inserts, browsers never write directly.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Dev only: write waitlist emails to data/waitlist.jsonl when Supabase is absent/failing.
WAITLIST_LOCAL_FALLBACK=

# CORS
CORS_ORIGINS=http://localhost:5173

# Per-IP AI budget. Enforcement is token-based; dollar values are display estimates.
IP_BUDGET_ENABLED=1
IP_TOKEN_BUDGET=1000000
IP_BUDGET_WINDOW_HOURS=24
PRICE_IN_PER_M=0.50
PRICE_OUT_PER_M=1.50
USAGE_DB_PATH=data/usage.db
# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Enables GET /api/metrics/usage via X-Admin-Token. Leave blank to disable.
ADMIN_TOKEN=

# Single shared API key, sent as X-API-Key header or Bearer token.
# Enforced on all endpoints except health/models/usage/waitlist. Required when ENV=prod.
API_KEY=
# Deployment environment: dev | prod. Prod refuses to boot without API_KEY.
ENV=dev
